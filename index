<!DOCTYPE html>
<html lang="en">

<head>

  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >

  <title>Item Selection</title>


  <link
    rel="stylesheet"
    href="style.css"
  >

</head>


<body>


  <main class="page">


    <section class="card">


      <div class="header">

        <h1>
          Item Selection
        </h1>

        <p>
          Select an Item Name to load its related Part Numbers.
        </p>

      </div>


      <!-- Loading -->

      <div
        id="loading"
        class="loading"
      >

        <div class="spinner"></div>

        <span>
          Loading database...
        </span>

      </div>


      <!-- Error -->

      <div
        id="errorMessage"
        class="message error"
        hidden
      >
      </div>


      <!-- Item Name -->

      <div class="field">

        <label
          for="itemName"
        >
          Item Name
        </label>


        <select
          id="itemName"
          disabled
        >

          <option value="">
            Select Item Name
          </option>

        </select>

      </div>


      <!-- Part Number -->

      <div class="field">

        <label
          for="partNumber"
        >
          Part Number
        </label>


        <select
          id="partNumber"
          disabled
        >

          <option value="">
            Select Part Number
          </option>

        </select>

      </div>


      <!-- Selection Result -->

      <div
        id="selectionResult"
        class="selection-result"
        hidden
      >

        <div class="result-row">

          <span class="result-label">
            Item Name
          </span>

          <span
            id="selectedItemName"
            class="result-value"
          >
          </span>

        </div>


        <div class="result-row">

          <span class="result-label">
            Part Number
          </span>

          <span
            id="selectedPartNumber"
            class="result-value"
          >
          </span>

        </div>

      </div>


    </section>


  </main>


  <script src="script.js"></script>

</body>

</html>
